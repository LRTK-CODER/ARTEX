#!/usr/bin/env python3
"""main으로 가는 push, fast-forward가 아닌 push, 규칙에 맞지 않는 브랜치 이름의 push를 거부한다.

브랜치 이름 검사는 .claude/hooks/branching_guard.py 의 branch_name_problem을 그대로 쓴다.
규칙: .claude/rules/branching.md
"""
import os
import subprocess
import sys

RULES_DOC = ".claude/rules/branching.md"


def load_branching_guard():
    sys.dont_write_bytecode = True  # worktree에 __pycache__를 남기지 않는다
    hooks_dir = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                             ".claude", "hooks")
    sys.path.insert(0, hooks_dir)
    import branching_guard
    return branching_guard


def is_zero(sha):
    return set(sha) == {"0"}


def is_ancestor(old, new):
    return subprocess.run(["git", "merge-base", "--is-ancestor", old, new],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def current_branch_ref():
    p = subprocess.run(["git", "symbolic-ref", "-q", "HEAD"],
                       stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    return p.stdout.strip()


def main():
    try:
        rules = load_branching_guard()
    except Exception as e:  # noqa: BLE001
        rules = None
        sys.stderr.write("[pre-push 경고] branching_guard.py를 읽지 못해 브랜치 이름 검사를 건너뛴다: {}\n".format(e))

    errors = []
    for line in sys.stdin:
        parts = line.split()
        if len(parts) != 4:
            continue
        local_ref, local_sha, remote_ref, remote_sha = parts
        if remote_ref == "refs/heads/main":
            errors.append(("main으로 가는 push ({} -> {})".format(local_ref, remote_ref),
                           "main은 PR의 squash merge로만 바뀐다",
                           "작업 브랜치를 push하고 PR을 연다"))
            continue
        if is_zero(local_sha):
            continue  # 원격 브랜치 삭제
        if not is_zero(remote_sha) and not is_ancestor(remote_sha, local_sha):
            errors.append(("fast-forward가 아닌 push ({})".format(remote_ref),
                           "force push는 모든 브랜치에서 금지다",
                           "`git merge origin/<브랜치>`로 원격 커밋을 포함시킨 뒤 일반 push를 한다"))
        if rules is None:
            continue
        if local_ref == "HEAD":  # `git push origin HEAD:<이름>`
            local_ref = current_branch_ref()
        for ref in dict.fromkeys((remote_ref, local_ref)):
            if not ref.startswith("refs/heads/"):
                continue
            name = ref[len("refs/heads/"):]
            problem = rules.branch_name_problem(name)
            if problem:
                errors.append(("규칙에 맞지 않는 브랜치 이름 '{}'".format(name), problem,
                               "`git branch -m <새 이름>`으로 고친 뒤 push한다"))

    for what, why, instead in errors:
        sys.stderr.write("차단: {}\n이유: {}\n대신: {} (규칙: {})\n".format(what, why, instead, RULES_DOC))
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
