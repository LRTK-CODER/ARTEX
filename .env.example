# Docker 배포 설정(.env로 복사해 쓴다)
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM(둘 중 하나나 둘 다 채운다. 비워 두고 UI에서 설정해도 된다)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 서버 키 디렉터리(jwt.key, oauth.key)는 이미지가 ARTEX_KEY_DIR=/app/keys 로 정하고,
# docker-compose.yml 이 프로젝트 루트의 ./keys 에 붙인다. 바꿀 일이 없으면 여기서 정하지 않는다.
# ./keys 를 잃으면 웹 세션이 끊기고 ChatGPT 구독 로그인을 다시 해야 한다. ./data 와 함께 백업한다.

# 에이전트 명령을 서버와 다른 uid로 실행한다(기본 꺼짐, README "에이전트 uid 분리").
# 이미지의 artex-agent 사용자(20000)를 쓴다. 켜면 nmap -sS·-O처럼 raw 소켓이 필요한 스캔은 쓸 수 없고 -sT를 쓴다.
ARTEX_AGENT_UID=
ARTEX_AGENT_GID=
